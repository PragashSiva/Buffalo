# Neon Postgres (free tier) — https://neon.tech
# Create a free project, then copy the connection string from the dashboard.
# It looks like:
#   postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require
# The app creates its tables automatically on first use — no migration step.
DATABASE_URL=

# Finnhub (free tier) — https://finnhub.io
# Free API key, 60 calls/min. Required for live prices on Vercel, because
# Yahoo and Stooq block datacenter IPs. Without it, charts/quotes error.
FINNHUB_API_KEY=

# Twelve Data (free tier) — https://twelvedata.com
# Free API key, 800 calls/day, 8/min. Chart source: 1h and 1day candles
# (free Finnhub does not include candles). Without it, charts fall back
# to Yahoo/Stooq, which fail from Vercel.
TWELVEDATA_API_KEY=
